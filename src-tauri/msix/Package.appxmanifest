<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store build. A TEMPLATE: never pass
  this file to a packager directly. tools/pack-msix.mjs fills the double-brace
  placeholders (identity from store-identity.json, version from
  tauri.conf.json) into a copy beside the staging folder, then runs
  `winapp package` over that folder.

  - Full-trust desktop app (Desktop Bridge): Windows.FullTrustApplication +
    runFullTrust. The runner spawns the learner's own Python/Node from PATH,
    which a full-trust packaged app may do. Writes to %APPDATA% are redirected
    into the package's own storage and removed on uninstall.
  - No internetClient capability: Anvil is offline and never talks to a
    network. Full-trust apps aren't sandboxed by capabilities anyway, so this
    only keeps the Store listing honest.
  - The bundled resources/ tree (packs, lessons, curriculum, pylib) is staged
    beside the exe, exactly where Tauri's resource_dir() looks on Windows.
  - WebView2: MSIX can't run the WebView2 bootstrapper. Windows 11 ships the
    Evergreen runtime, and Windows 10 gets it with Microsoft Edge.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 and later. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Anvil" Executable="{{EXECUTABLE}}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Free, offline guided DSA course: learn a pattern, take the quiz, solve it against real tests."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Anvil">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
